#!/usr/bin/env python3
"""Repeatable secret scan for a public repository.

`maff0000/GOAL` is public and stays public. This command is the deterministic,
repeatable proof that no secret has entered the repository. It runs two scans,
because a clean working tree says nothing about what is in history:

    1. working tree  -- gitleaks dir <target>
    2. git history   -- gitleaks git <target>

Exit codes:

    0   both scans ran and both were clean
    1   a scan ran and reported findings
    2   gitleaks is unavailable, or a scan could not run

A scan that could not run is never reported as a scan that passed, so exit 2
takes precedence over exit 1: exit 1 asserts "the scans ran and found
something", which would be a false claim if one of them never ran.

Output is deterministic: no timestamps, no durations, no hostnames, no
usernames, and no absolute paths. Secret values are redacted by gitleaks
before they reach the report, so a finding is reported by rule id and
target-relative path only.
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

GITLEAKS_FALLBACK = "/usr/local/bin/gitleaks"

# gitleaks exits 1 both for "leaks found" and for "the scan blew up", which
# makes those two outcomes indistinguishable. --exit-code moves the
# leaks-found signal onto a dedicated code so any other non-zero exit can be
# treated as a failure to scan.
FINDINGS_EXIT_CODE = 7

CLEAN = "CLEAN"
FINDINGS = "FINDINGS"
ERROR = "ERROR"


def repo_root() -> pathlib.Path:
    """Repository root, derived from this script's own location.

    tools/secret-scan -> <repo root>. Deliberately not the current working
    directory, so the command means the same thing from anywhere.
    """
    return pathlib.Path(__file__).resolve().parent.parent


def find_gitleaks() -> str | None:
    """Locate the gitleaks binary, preferring PATH over a fixed location."""
    found = shutil.which("gitleaks")
    if found:
        return found
    if os.access(GITLEAKS_FALLBACK, os.X_OK):
        return GITLEAKS_FALLBACK
    return None


def _relative(path: str, target: pathlib.Path) -> str:
    """Render a reported path relative to the target, never absolute."""
    if not path:
        return "(unknown path)"
    candidate = pathlib.Path(path)
    if candidate.is_absolute():
        try:
            return candidate.relative_to(target).as_posix()
        except ValueError:
            return candidate.name
    return candidate.as_posix()


def _read_report(report_path: pathlib.Path, target: pathlib.Path) -> list[str]:
    """Sorted 'rule-id path' lines from a gitleaks JSON report."""
    try:
        text = report_path.read_text(encoding="utf-8")
    except OSError:
        return []
    if not text.strip():
        return []
    try:
        findings = json.loads(text)
    except json.JSONDecodeError:
        return []
    if not isinstance(findings, list):
        return []
    lines = set()
    for finding in findings:
        if not isinstance(finding, dict):
            continue
        rule = str(finding.get("RuleID") or "(unknown rule)")
        lines.add("%s %s" % (rule, _relative(str(finding.get("File") or ""), target)))
    return sorted(lines)


def _run_gitleaks(
    gitleaks: str, mode: str, target: pathlib.Path
) -> tuple[str, list[str], str]:
    """Run one gitleaks scan.

    Returns (outcome, finding lines, detail) where outcome is CLEAN, FINDINGS
    or ERROR.
    """
    with tempfile.TemporaryDirectory(prefix="secret-scan-") as workdir:
        # The report is written outside the target so that scanning a
        # directory never picks up this run's own report file.
        report_path = pathlib.Path(workdir) / "report.json"
        command = [
            gitleaks,
            mode,
            str(target),
            "--no-banner",
            "--no-color",
            "--redact",
            "--exit-code",
            str(FINDINGS_EXIT_CODE),
            "--report-format",
            "json",
            "--report-path",
            str(report_path),
        ]
        try:
            completed = subprocess.run(
                command,
                cwd=workdir,
                capture_output=True,
                text=True,
                check=False,
            )
        except OSError as exc:
            return ERROR, [], "could not execute gitleaks (%s)" % exc.strerror

        if completed.returncode == 0:
            return CLEAN, [], ""
        if completed.returncode == FINDINGS_EXIT_CODE:
            lines = _read_report(report_path, target)
            if not lines:
                # gitleaks said it found something but the report did not
                # survive. Report the count honestly rather than claiming to
                # know what it was.
                return FINDINGS, ["(findings reported, report unreadable)"], ""
            return FINDINGS, lines, ""
        return ERROR, [], "gitleaks exited %d" % completed.returncode


def scan_working_tree(gitleaks: str, target: pathlib.Path) -> tuple[str, list[str], str]:
    if not target.is_dir():
        return ERROR, [], "target is not a directory"
    return _run_gitleaks(gitleaks, "dir", target)


def scan_git_history(gitleaks: str, target: pathlib.Path) -> tuple[str, list[str], str]:
    """Scan full git history.

    Preconditions are checked first because `gitleaks git` exits 0 with
    "0 commits scanned" when handed a path that is not a git repository.
    Trusting that exit status would report an unscanned history as clean.
    """
    if not target.is_dir():
        return ERROR, [], "target is not a directory"
    git = shutil.which("git")
    if git is None:
        return ERROR, [], "git is not available to confirm the target is a repository"
    probe = subprocess.run(
        [git, "-C", str(target), "rev-parse", "--git-dir"],
        capture_output=True,
        text=True,
        check=False,
    )
    if probe.returncode != 0:
        return ERROR, [], "target is not a git repository, so history cannot be scanned"
    head = subprocess.run(
        [git, "-C", str(target), "rev-parse", "--verify", "HEAD"],
        capture_output=True,
        text=True,
        check=False,
    )
    if head.returncode != 0:
        return ERROR, [], "target has no commits, so history cannot be scanned"
    return _run_gitleaks(gitleaks, "git", target)


SCANS = (
    ("working-tree", "gitleaks dir", scan_working_tree),
    ("git-history", "gitleaks git", scan_git_history),
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="secret-scan",
        description=(
            "Scan a repository for secrets with gitleaks, covering both the "
            "working tree and full git history."
        ),
        epilog=(
            "Exit codes: 0 both scans clean; 1 a scan reported findings; "
            "2 gitleaks unavailable or a scan could not run."
        ),
    )
    parser.add_argument(
        "target",
        nargs="?",
        default=None,
        help=(
            "directory to scan (default: the repository this script lives in, "
            "regardless of the current working directory)"
        ),
    )
    args = parser.parse_args(argv)

    target = pathlib.Path(args.target).resolve() if args.target else repo_root()

    print("secret-scan")

    gitleaks = find_gitleaks()
    if gitleaks is None:
        print("  working-tree (gitleaks dir): ERROR - gitleaks not found")
        print("  git-history (gitleaks git): ERROR - gitleaks not found")
        print("RESULT: ERROR")
        print("gitleaks is not installed or not on PATH; no scan was performed.")
        return 2

    outcomes = []
    for name, tool, scan in SCANS:
        outcome, lines, detail = scan(gitleaks, target)
        outcomes.append(outcome)
        label = "  %s (%s):" % (name, tool)
        if outcome == CLEAN:
            print("%s CLEAN" % label)
        elif outcome == FINDINGS:
            print("%s %d finding(s)" % (label, len(lines)))
            for line in lines:
                print("      %s" % line)
        else:
            print("%s ERROR - %s" % (label, detail))

    if ERROR in outcomes:
        print("RESULT: ERROR")
        return 2
    if FINDINGS in outcomes:
        print("RESULT: FINDINGS")
        return 1
    print("RESULT: CLEAN")
    return 0


if __name__ == "__main__":
    sys.exit(main())
